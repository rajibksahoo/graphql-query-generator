    "test:watch": "vitest",
    "test-server": "node test-server/server.js"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "graphql": "^16.8.0",
    "inquirer": "^8.2.6",
    "inquirer-checkbox-plus-prompt": "^1.4.2"
  },
  "devDependencies": {
    "apollo-server": "^3.12.0",
    "vitest": "^1.0.0"
